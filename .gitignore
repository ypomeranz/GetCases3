__pycache__/
*.pyc
*.pyo

# English Reports index build scratch (raw toc HTML + intermediates + builders).
# The shipped product, eng_rep_index.tsv.gz, lives in the repo root.
_engr_build/

# Legislative-history index build scratch (GovInfo and Congress.gov crawls,
# their raw output, the builders).  The shipped products, crecb_index.tsv.gz
# and debates_index.tsv.gz, live in the repo root.
_leghist_build/

# SEC Decisions and Reports index build scratch (the HathiTrust Research
# Center's Extracted Features for each volume, the builders).  The shipped
# product, sec_index.tsv.gz, lives in the repo root.
_sec_build/

# Opinion database: opinions.jsonl IS committed (the source of truth that syncs
# via GitHub), but the local SQLite search index is derived from it and rebuilt
# on demand, so it is never tracked.
*.index.db

# US Reports bound-volume / preliminary-print PDFs (vols 584+): big binaries
# that us_reports_pdf.py downloads from supremecourt.gov on demand (and
# carves per-opinion PDFs out of), so never tracked.
US Reports/
